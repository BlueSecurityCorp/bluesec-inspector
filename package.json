{
  "name": "bluesec-inspector",
  "version": "0.2.0",
  "description": "Chrome MV3 side-panel inspector for Console and Elements workflows using chrome.debugger and Chrome DevTools Protocol.",
  "private": true,
  "type": "module",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "chrome-devtools-protocol",
    "cdp",
    "chrome-debugger",
    "devtools",
    "console",
    "dom-inspector",
    "elements-panel",
    "security-research",
    "browser-security",
    "typescript",
    "react",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueSecurityCorp/bluesec-inspector.git"
  },
  "author": "blue / BlueSecurity",
  "license": "MIT",
  "scripts": {
    "dev": "vite --mode development",
    "build": "tsc && vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.2.0",
    "typescript": "^5.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22"
  }
}
